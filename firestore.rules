rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users Profile Collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Fridges Collection
    match /fridges/{fridgeId} {
      // Allow read/update/delete only for authorized users
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.authorizedUsers;
      // Allow create only if the creator includes themselves in the authorizedUsers list
      allow create: if request.auth != null && request.auth.uid in request.resource.data.authorizedUsers;
      
      // Allow authorized users read/write access to all nested subcollections (items, gas_alerts, shelves, etc.)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/fridges/$(fridgeId)).data.authorizedUsers;
      }
    }
  }
}
