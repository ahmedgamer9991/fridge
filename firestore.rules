rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users Profile Collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Fridges Collection
    match /fridges/{fridgeId} {
      // Allow read/update/delete only for authorized users
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.authorizedUsers;
      // Allow create only if the creator includes themselves in the authorizedUsers list
      allow create: if request.auth != null && request.auth.uid in request.resource.data.authorizedUsers;
      
      // Explicit Subcollection Match Blocks with dynamic database path
      match /items/{itemId} {
        allow read, write: if request.auth != null && (
          !exists(/databases/$(database)/documents/fridges/$(fridgeId)) ||
          request.auth.uid in get(/databases/$(database)/documents/fridges/$(fridgeId)).data.authorizedUsers
        );
      }
      
      match /gas_alerts/{alertId} {
        allow read, write: if request.auth != null && (
          !exists(/databases/$(database)/documents/fridges/$(fridgeId)) ||
          request.auth.uid in get(/databases/$(database)/documents/fridges/$(fridgeId)).data.authorizedUsers
        );
      }
      
      match /shelves/{shelfId} {
        allow read, write: if request.auth != null && (
          !exists(/databases/$(database)/documents/fridges/$(fridgeId)) ||
          request.auth.uid in get(/databases/$(database)/documents/fridges/$(fridgeId)).data.authorizedUsers
        );
      }
    }
  }
}
